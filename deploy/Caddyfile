xonobodbugun.uz, www.xonobodbugun.uz {
    encode zstd gzip

    @vendor path /vendor/*
    handle @vendor {
        reverse_proxy 127.0.0.1:8000 {
            header_down Cache-Control "public, max-age=31536000, immutable"
        }
    }

    @assets path / /index.html /js/* /css/*
    handle @assets {
        reverse_proxy 127.0.0.1:8000 {
            header_down Cache-Control "no-cache, must-revalidate"
        }
    }

    handle {
        reverse_proxy 127.0.0.1:8000
    }
}