[Unit]
Description=Xonobod Bugun Telegram Bot + TTL Worker
After=network.target xonobod-web.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/xonobod-bugun
EnvironmentFile=/opt/xonobod-bugun/.env
ExecStart=/opt/xonobod-bugun/.venv/bin/python /opt/xonobod-bugun/run_bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target